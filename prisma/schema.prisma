generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                        @id @default(uuid())
  email                        String                        @unique
  password                     String
  firstName                    String
  lastName                     String
  phone                        String?
  role                         UserRole                      @default(ADMIN)
  branchId                     String?
  departmentId                 String?
  employeeId                   String?                       @unique
  officeLocationId             String?
  joiningDate                  DateTime?
  leavingDate                  DateTime?
  address                      String?
  isActive                     Boolean                       @default(true)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  assetAssignments             AssetAssignment[]
  attendanceLogs               AttendanceActivityLog[]
  reviewedCorrectionRequests   AttendanceCorrectionRequest[] @relation("CorrectionReviewer")
  attendanceCorrectionRequests AttendanceCorrectionRequest[] @relation("CorrectionRequester")
  auditLogs                    AuditLog[]
  brochureIssues               BrochureIssue[]
  courierRequests              CourierRequest[]
  expenses                     Expense[]
  idCardAssignments            IdCard[]                      @relation("IdCardAssignee")
  joiningKitIssues             JoiningKitIssue[]
  notifications                Notification[]
  attendances                  OfficeBoyAttendance[]
  passwordResetTokens          PasswordResetToken[]
  refreshTokens                RefreshToken[]
  assignedRequests             Request[]                     @relation("RequestAssignee")
  requests                     Request[]                     @relation("RequestCreator")
  branch                       Branch?                       @relation(fields: [branchId], references: [id])
  department                   Department?                   @relation(fields: [departmentId], references: [id])
  officeLocation               OfficeLocation?               @relation(fields: [officeLocationId], references: [id])

  @@index([role])
  @@index([branchId])
  @@index([departmentId])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Branch {
  id               String                @id @default(uuid())
  name             String
  code             String                @unique
  address          String?
  city             String?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  amcRecords       AmcRecord[]
  assets           Asset[]
  brochureStock    BrochureStock[]
  courierRequests  CourierRequest[]
  departments      Department[]
  expenses         Expense[]
  idCards          IdCard[]
  joiningKitIssues JoiningKitIssue[]
  joiningKitStock  JoiningKitStock[]
  attendances      OfficeBoyAttendance[]
  officeLocations  OfficeLocation[]
  pgRecords        PgRecord[]
  requests         Request[]
  seatingRecords   SeatingRecord[]
  users            User[]
}

model Entity {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])
  users     User[]

  @@index([branchId])
}

model Vendor {
  id              String           @id @default(uuid())
  name            String
  contact         String?
  email           String?
  phone           String?
  address         String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  amcRecords      AmcRecord[]
  courierRequests CourierRequest[]
  expenses        Expense[]
}

model AssetCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Request {
  id           String        @id @default(uuid())
  title        String
  description  String?
  type         String
  status       RequestStatus @default(DRAFT)
  branchId     String?
  createdById  String
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedTo   User?         @relation("RequestAssignee", fields: [assignedToId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  createdBy    User          @relation("RequestCreator", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
}

model CourierRequest {
  id              String        @id @default(uuid())
  requestNumber   String        @unique
  pickupAddress   String
  deliveryAddress String
  recipientName   String?
  recipientPhone  String?
  description     String?
  status          CourierStatus @default(SUBMITTED)
  trackingNumber  String?
  vendorId        String?
  branchId        String?
  createdById     String
  pickupDate      DateTime?
  deliveryDate    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  vendor          Vendor?       @relation(fields: [vendorId], references: [id])

  @@index([branchId])
  @@index([vendorId])
  @@index([createdById])
  @@index([status])
}

model Asset {
  id           String            @id @default(uuid())
  name         String
  serialNumber String?           @unique
  description  String?
  categoryId   String?
  branchId     String?
  status       AssetStatus       @default(AVAILABLE)
  purchaseDate DateTime?
  warrantyEnd  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignedDate DateTime?
  employeeCode String?
  location     String?
  employeeName String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  category     AssetCategory?    @relation(fields: [categoryId], references: [id])
  assignments  AssetAssignment[]

  @@index([branchId])
  @@index([categoryId])
  @@index([status])
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  userId     String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  condition  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  asset      Asset     @relation(fields: [assetId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@index([userId])
}

model JoiningKitItem {
  id          String                @id @default(uuid())
  name        String
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  issues      JoiningKitIssueItem[]
  stock       JoiningKitStock[]
}

model JoiningKitStock {
  id        String         @id @default(uuid())
  itemId    String
  branchId  String?
  quantity  Int            @default(0)
  minStock  Int            @default(5)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branch    Branch?        @relation(fields: [branchId], references: [id])
  item      JoiningKitItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, branchId])
}

model JoiningKitIssue {
  id           String                @id @default(uuid())
  issueNumber  String                @unique
  userId       String
  notes        String?
  issuedAt     DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  branchId     String?
  employeeId   String?
  employeeName String?
  isReturned   Boolean               @default(false)
  joiningDate  DateTime?
  location     String?
  returnedAt   DateTime?
  branch       Branch?               @relation(fields: [branchId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  items        JoiningKitIssueItem[]
}

model JoiningKitIssueItem {
  id       String          @id @default(uuid())
  issueId  String
  itemId   String
  quantity Int
  issue    JoiningKitIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item     JoiningKitItem  @relation(fields: [itemId], references: [id])
}

model Expense {
  id          String           @id @default(uuid())
  title       String
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  expenseDate DateTime
  categoryId  String?
  vendorId    String?
  entityId    String?
  branchId    String?
  createdById String
  billUrl     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invoiceUrl  String?
  branch      Branch?          @relation(fields: [branchId], references: [id])
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  entity      Entity?          @relation(fields: [entityId], references: [id])
  vendor      Vendor?          @relation(fields: [vendorId], references: [id])

  @@index([branchId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([createdById])
  @@index([expenseDate])
}

model IdCard {
  id           String    @id @default(uuid())
  cardNumber   String    @unique
  branchId     String?
  assignedToId String?
  assignedAt   DateTime?
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  receivedDate DateTime?
  assignedTo   User?     @relation("IdCardAssignee", fields: [assignedToId], references: [id])
  branch       Branch?   @relation(fields: [branchId], references: [id])
}

model AmcRecord {
  id                String    @id @default(uuid())
  title             String
  vendorId          String?
  branchId          String?
  location          String?
  startDate         DateTime
  endDate           DateTime
  amount            Decimal?  @db.Decimal(12, 2)
  description       String?
  documentUrl       String?
  status            AmcStatus @default(ACTIVE)
  reminderDays      Int       @default(30)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  emailNotification Boolean   @default(true)
  branch            Branch?   @relation(fields: [branchId], references: [id])
  vendor            Vendor?   @relation(fields: [vendorId], references: [id])
}

model SeatingRecord {
  id            String   @id @default(uuid())
  branchId      String
  floor         String
  totalSeats    Int
  occupiedSeats Int
  recordDate    DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  zone          String?
  branch        Branch   @relation(fields: [branchId], references: [id])
}

model BrochureStock {
  id        String          @id @default(uuid())
  name      String
  branchId  String?
  quantity  Int             @default(0)
  minStock  Int             @default(10)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  issues    BrochureIssue[]
  branch    Branch?         @relation(fields: [branchId], references: [id])
}

model BrochureIssue {
  id          String        @id @default(uuid())
  issueNumber String        @unique
  stockId     String
  userId      String
  quantity    Int
  issuedAt    DateTime      @default(now())
  notes       String?
  createdAt   DateTime      @default(now())
  stock       BrochureStock @relation(fields: [stockId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
}

model PgRecord {
  id             String   @id @default(uuid())
  employeeName   String
  branchId       String?
  address        String
  rentAmount     Decimal  @db.Decimal(12, 2)
  agreementStart DateTime
  agreementEnd   DateTime
  contactPhone   String?
  status         PgStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fileAttachment String?
  location       String?
  raisedBy       String?
  reminderDays   Int      @default(5)
  branch         Branch?  @relation(fields: [branchId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Attachment {
  id                 String   @id @default(uuid())
  fileName           String
  fileUrl            String
  mimeType           String?
  fileSize           Int?
  module             String
  recordId           String
  uploadedBy         String?
  cloudinaryPublicId String?
  createdAt          DateTime @default(now())

  @@index([recordId])
  @@index([module])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  recordId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ImportJob {
  id          String   @id @default(uuid())
  module      String
  fileName    String
  status      String   @default("PENDING")
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  errors      String?
  branchId    String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfficeLocation {
  id                  String                @id @default(uuid())
  name                String
  branchId            String
  latitude            Decimal               @db.Decimal(10, 7)
  longitude           Decimal               @db.Decimal(10, 7)
  allowedRadiusMeters Int                   @default(100)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  attendances         OfficeBoyAttendance[]
  branch              Branch                @relation(fields: [branchId], references: [id])
  staff               User[]

  @@index([branchId])
}

model OfficeBoyAttendance {
  id                     String                        @id @default(uuid())
  userId                 String
  branchId               String
  locationId             String
  attendanceDate         DateTime                      @db.Date
  loginTime              DateTime?
  logoutTime             DateTime?
  loginLatitude          Decimal?                      @db.Decimal(10, 7)
  loginLongitude         Decimal?                      @db.Decimal(10, 7)
  logoutLatitude         Decimal?                      @db.Decimal(10, 7)
  logoutLongitude        Decimal?                      @db.Decimal(10, 7)
  loginDistanceMeters    Float?
  logoutDistanceMeters   Float?
  workingDurationMinutes Int?
  status                 AttendanceStatus              @default(INCOMPLETE)
  isLate                 Boolean                       @default(false)
  lateReason             String?
  isEarlyLeave           Boolean                       @default(false)
  earlyLeaveReason       String?
  deviceInfo             String?
  isSessionActive        Boolean                       @default(false)
  loginPhotoUrl          String?
  logoutPhotoUrl         String?
  approvedCorrectionType AttendanceCorrectionType?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  correctionRequests     AttendanceCorrectionRequest[]
  branch                 Branch                        @relation(fields: [branchId], references: [id])
  location               OfficeLocation                @relation(fields: [locationId], references: [id])
  user                   User                          @relation(fields: [userId], references: [id])

  @@unique([userId, attendanceDate])
  @@index([attendanceDate])
  @@index([branchId])
  @@index([locationId])
}

model AttendanceCorrectionRequest {
  id           String                     @id @default(uuid())
  attendanceId String
  userId       String
  requestType  AttendanceCorrectionType
  comments     String
  status       AttendanceCorrectionStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  adminNotes   String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  attendance   OfficeBoyAttendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  reviewedBy   User?                      @relation("CorrectionReviewer", fields: [reviewedById], references: [id])
  user         User                       @relation("CorrectionRequester", fields: [userId], references: [id])

  @@index([attendanceId])
  @@index([userId])
  @@index([status])
}

model AttendanceActivityLog {
  id             String                 @id @default(uuid())
  userId         String
  action         AttendanceActivityType
  latitude       Decimal?               @db.Decimal(10, 7)
  longitude      Decimal?               @db.Decimal(10, 7)
  distanceMeters Float?
  message        String?
  createdAt      DateTime               @default(now())
  user           User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OFFICE_BOY
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  ON_HOLD
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETURNED
  DAMAGED
  UNDER_REPAIR
  LOST
}

enum CourierStatus {
  SUBMITTED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum AmcStatus {
  ACTIVE
  EXPIRED
  RENEWED
  CLOSED
}

enum PgStatus {
  ACTIVE
  EXPIRED
  RENEWED
  CLOSED
}

enum NotificationType {
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_COMPLETED
  ASSET_ASSIGNED
  COURIER_DELIVERY
  LOW_STOCK
  CONTRACT_EXPIRY
  ACCOMMODATION_EXPIRY
  ATTENDANCE_CORRECTION_REQUEST
  ATTENDANCE_CORRECTION_APPROVED
  ATTENDANCE_CORRECTION_REJECTED
  GENERAL
}

enum AttendanceStatus {
  PRESENT
  FULL_DAY
  HALF_DAY
  EARLY_LEAVE
  ABSENT
  PARTIAL
  LATE
  INCOMPLETE
  REJECTED_LOCATION
  HOLIDAY
}

enum AttendanceCorrectionType {
  PRESENT_FULL_DAY
  PRESENT_FULL_DAY_NOT_COMPLETED_9H
  PRESENT_HALF_DAY
  ABSENT_INFORMED_SENIOR
  HOLIDAY
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceActivityType {
  LOGIN_SUCCESS
  LOGOUT_SUCCESS
  LOGIN_LOCATION_REJECTED
  LOGOUT_LOCATION_REJECTED
  LOGIN_LOCATION_PERMISSION_DENIED
  LOGOUT_LOCATION_PERMISSION_DENIED
  LOGIN_ALREADY_ACTIVE
  LOGOUT_WITHOUT_LOGIN
  LOGOUT_ALREADY_COMPLETED
}
